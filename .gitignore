__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============ 编辑器 / 系统 ============
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
